        // --- Streamlined Player Management ---
        function openPlayerModal(playerId = null) {
            const modal = document.getElementById('player-modal');
            const form = document.getElementById('player-form');
            form.reset();
            document.getElementById('player-id').value = '';

            if (playerId) {
                document.getElementById('modal-title').innerText = 'Editar Jogador';
                const player = appState.players.find(p => p.id === playerId);
                if (player) {
                    document.getElementById('player-id').value = player.id;
                    document.getElementById('player-name').value = player.name;
                    document.getElementById('player-level').value = player.level;
                }
            } else {
                document.getElementById('modal-title').innerText = 'Adicionar Novo Jogador';
            }
            modal.classList.remove('hidden');
        }

        function closePlayerModal() {
            document.getElementById('player-modal').classList.add('hidden');
        }

        function handlePlayerSubmit(e) {
            e.preventDefault();
            const id = document.getElementById('player-id').value;
            const name = document.getElementById('player-name').value.trim();
            const level = document.getElementById('player-level').value;

            if (!name) return;

            if (id) {
                const p = appState.players.find(item => item.id === id);
                if (p) {
                    p.name = name;
                    p.level = level;
                    showToast('Jogador atualizado com sucesso!');
                }
            } else {
                const newPlayer = {
                    id: 'p_' + Math.random().toString(36).substr(2, 9),
                    name,
                    level
                };
                appState.players.push(newPlayer);
                // Adicionar automaticamente às seleções se houver espaço
                if (!appState.selectedLivrePlayers.includes(newPlayer.id) && appState.selectedLivrePlayers.length < 4) {
                    appState.selectedLivrePlayers.push(newPlayer.id);
                }
                appState.selectedAmericanoPlayers.push(newPlayer.id);
                showToast('Jogador adicionado com sucesso!');
            }

            saveData();
            closePlayerModal();
            renderPlayers();
        }

